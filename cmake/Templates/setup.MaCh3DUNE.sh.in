#!/bin/sh

# NB: these helpers are defined unconditionally, on purpose. Guarding them with
# `if ! type add_to_PATH` means a definition left over in the shell from an
# earlier source -- or one belonging to a different project -- silently wins
# over ours, and re-sourcing this script can then never repair it.

### Adapted from https://unix.stackexchange.com/questions/4965/keep-duplicates-out-of-path-on-source
add_to_PATH() {
  for d; do

    # canonicalize symbolic links; the redirect has to sit INSIDE the
    # substitution, or cd's error for a missing dir (e.g. no lib64 on macOS)
    # escapes to the terminal
    d=$(cd -- "$d" 2>/dev/null && { pwd -P || pwd; })
    if [ -z "$d" ]; then continue; fi  # skip nonexistent directory

    # NB: POSIX test only has `=`. With `==`, zsh treats the bare `==` word as
    # an =command expansion and fails with "= not found".
    if [ "$d" = "/usr/bin" ] || [ "$d" = "/usr/bin64" ] || [ "$d" = "/usr/local/bin" ] || [ "$d" = "/usr/local/bin64" ]; then
      case ":$PATH:" in
        *":$d:"*) :;;
        *) export PATH=$PATH:$d;;
      esac
    else
      case ":$PATH:" in
        *":$d:"*) :;;
        *) export PATH=$d:$PATH;;
      esac
    fi
  done
}

add_to_LD_LIBRARY_PATH() {
  for d; do

    d=$(cd -- "$d" 2>/dev/null && { pwd -P || pwd; })
    if [ -z "$d" ]; then continue; fi  # skip nonexistent directory

    if [ "$d" = "/usr/lib" ] || [ "$d" = "/usr/lib64" ] || [ "$d" = "/usr/local/lib" ] || [ "$d" = "/usr/local/lib64" ]; then
      case ":$LD_LIBRARY_PATH:" in
        *":$d:"*) :;;
        *) export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:$d;;
      esac
    else
      case ":$LD_LIBRARY_PATH:" in
        *":$d:"*) :;;
        *) export LD_LIBRARY_PATH=$d:$LD_LIBRARY_PATH;;
      esac
    fi
  done
}

is_in_PATH() {
  case ":$PATH:" in
  *:${1}:*) return 0 ;;
  *) return 1 ;;
  esac
}

export MACH3DUNE_ROOT=@CMAKE_INSTALL_PREFIX@
export MACH3=@CMAKE_INSTALL_PREFIX@
export MaCh3DUNE_VERSION=@MaCh3DUNE_VERSION@

add_to_PATH "${MACH3DUNE_ROOT}/bin"
add_to_LD_LIBRARY_PATH ${MACH3DUNE_ROOT}/lib
add_to_LD_LIBRARY_PATH ${MACH3DUNE_ROOT}/lib64

if [ -f "${MACH3DUNE_ROOT}/bin/setup.MaCh3.sh" ]; then
  echo "Sourcing MaCh3 Core"
  source "${MACH3DUNE_ROOT}/bin/setup.MaCh3.sh"
fi
